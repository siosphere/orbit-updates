    <item>
      <title>Orbit 2026.11.7.1750</title>
      <pubDate>Sat, 07 Nov 2026 17:50:00 +0000</pubDate>
      <sparkle:version>202611071750</sparkle:version>
      <sparkle:shortVersionString>2026.11.7.1750</sparkle:shortVersionString>
