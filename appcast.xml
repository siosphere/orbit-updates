    <item>
      <title>Orbit 2026.11.24.1946</title>
      <pubDate>Tue, 24 Nov 2026 19:46:00 +0000</pubDate>
      <sparkle:version>202611241946</sparkle:version>
      <sparkle:shortVersionString>2026.11.24.1946</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <sparkle:releaseNotesLink>https://github.com/siosphere/orbit-updates/releases/tag/v202611241946</sparkle:releaseNotesLink>
      <orbit:note scope="all">Extensions like Bitwarden can now see pages opened in the mini browser, including their URL, tab events and focus changes.</orbit:note>
      <orbit:note scope="all">Bitwarden now shows logins for the site open in the mini browser (Peek), not the tab behind it.</orbit:note>
      <orbit:note scope="all">The mini browser's "Open in" button now names your current space and has a menu for moving the page to any other space.</orbit:note>
      <orbit:note>Images on Reddit now open in their viewer instead of bouncing back to the post when you open links in a new tab or Peek.</orbit:note>
      <orbit:chromium>156.0.8078.100</orbit:chromium>
      <enclosure url="https://github.com/siosphere/orbit-updates/releases/download/v202611241946/Orbit-202611241946.zip" length="161890828" type="application/octet-stream" sparkle:edSignature="aFUzbLom83R3W+0lo5OwOnJoCKiU4HVXVKTswESff0CaQLf4pJICp7ThMD9wl47o7XQd38BnNRzgXFNJi0U3Bg=="></enclosure>
